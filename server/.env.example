# Your MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=guess-the-ace

PORT=3001

# Comma-separated list of sites allowed to call the API (only needed when the
# client is hosted on a different domain; the Vite dev server uses a proxy).
CLIENT_ORIGIN=*

# Secret needed to wipe the leaderboard: DELETE /api/scores with header x-admin-key.
ADMIN_KEY=change-me
